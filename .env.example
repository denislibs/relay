# Пример .env боевого сервера (deploy/make-secrets.sh заполняет его сам). Здесь — ТОЛЬКО несекретные настройки:
# секреты — файлами в secrets/run/ (docker secrets, docs/deploy.md «Секреты»), в .env их не кладут.
RELAY_DOMAIN=
S3_PUBLIC_ENDPOINT=
RELAY_TURN_HOST=
RELAY_TURN_EXTERNAL_IP=
LIVEKIT_NODE_IP=
VAULT_ADDR=https://openbao:8200
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN=0
TELEGRAM_WEBHOOK_URL=
# 1 — метрики, тревоги и панель (deploy/docker-compose.observability.yml, docs/observability.md)
RELAY_OBSERVABILITY=0
# бэкапы (deploy/backup.sh): открытые ключи age и удалённые места rclone
AGE_DATA=
AGE_KEYS=
BACKUP_RCLONE_DATA=
BACKUP_RCLONE_KEYS=
