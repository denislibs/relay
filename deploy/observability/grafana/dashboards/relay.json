    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "query": {
     "query": "label_values(relay_build_info, build)",
     "refId": "build"
    },
    "definition": "label_values(relay_build_info, build)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1
   }
  ]
 },
