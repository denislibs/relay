    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "name": "Выкаты",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "enable": true,
    "iconColor": "purple",
    "expr": "changes(relay_build_info{job=\"server\"}[2m]) > 0 or (relay_build_info{job=\"server\"} unless relay_build_info{job=\"server\"} offset 2m)",
